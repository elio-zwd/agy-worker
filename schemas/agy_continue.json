{
  "$defs": {
    "Inputs": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Files",
          "type": "array"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Inputs",
      "type": "object"
    },
    "McpLimits": {
      "additionalProperties": false,
      "description": "正常 MCP 调用只允许调整任务总时长；上下文/证据预算使用服务端安全默认值。",
      "properties": {
        "total_timeout_sec": {
          "default": 600,
          "maximum": 1800,
          "minimum": 10,
          "title": "Total Timeout Sec",
          "type": "integer"
        }
      },
      "title": "McpLimits",
      "type": "object"
    },
    "McpPermissions": {
      "additionalProperties": false,
      "description": "Codex 可直接申请的当前公开权限；未开放能力不进入 MCP schema。",
      "properties": {
        "build": {
          "default": false,
          "title": "Build",
          "type": "boolean"
        },
        "test": {
          "default": false,
          "title": "Test",
          "type": "boolean"
        },
        "log": {
          "default": false,
          "title": "Log",
          "type": "boolean"
        },
        "browser": {
          "default": false,
          "title": "Browser",
          "type": "boolean"
        },
        "browser_interact": {
          "default": false,
          "title": "Browser Interact",
          "type": "boolean"
        },
        "origins": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Origins",
          "type": "array"
        },
        "android-ui": {
          "default": false,
          "title": "Android-Ui",
          "type": "boolean"
        },
        "device_serial": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Serial"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "vision": {
          "default": false,
          "title": "Vision",
          "type": "boolean"
        }
      },
      "title": "McpPermissions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "workspace_path": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Path"
    },
    "kind": {
      "enum": [
        "build",
        "test",
        "log",
        "browser",
        "android-ui",
        "vision"
      ],
      "title": "Kind",
      "type": "string"
    },
    "objective": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/McpPermissions"
    },
    "inputs": {
      "$ref": "#/$defs/Inputs"
    },
    "limits": {
      "$ref": "#/$defs/McpLimits"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "expected_turn": {
      "minimum": 1,
      "title": "Expected Turn",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "workspace_id",
    "kind",
    "objective",
    "session_id",
    "expected_turn"
  ],
  "title": "McpContinueRequest",
  "type": "object"
}